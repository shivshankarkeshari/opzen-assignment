DATABASE_URL=postgresql+psycopg://opzen:opzen_local@localhost:55432/opzen
MINIO_ENDPOINT=localhost:59000
MINIO_ACCESS_KEY=opzen
MINIO_SECRET_KEY=opzen_local_storage
MINIO_BUCKET=opzen-documents
MINIO_SECURE=false
API_URL=http://127.0.0.1:8000
# Local development identities only. Bind the API to loopback.
DEMO_IDENTITIES=analyst:analyst-local-key,reviewer:reviewer-local-key
UI_DEMO_USER=analyst
MAX_UPLOAD_MB=25
MAX_PAGES=200
PDF_BATCH_PAGES=20
CONVERSION_TIMEOUT=180
LEASE_SECONDS=600
CHUNK_TOKENS=450
# Soft body-token target: preserve short facts when no related neighbor fits.
CHUNK_MIN_TOKENS=100
TOKENIZER_ENCODING=cl100k_base
# Bound evidence per contextual-relevancy judge call; no evidence is truncated.
DEEPEVAL_CONTEXT_BATCH_MAX_ITEMS=16
DEEPEVAL_CONTEXT_BATCH_MAX_CHARS=8000
# Per metric across explicit resumes; valid scores (including low scores) are reused.
DEEPEVAL_METRIC_MAX_ATTEMPTS=2
DEEPEVAL_JUDGE_MAX_OUTPUT_TOKENS=4096
DOCLING_ARTIFACTS_PATH=
OCR_ENABLED=true
# Local, MIT-licensed Hugging Face encoder. Set backend=none for extraction only.
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_REVISION=a5beb1e3e68b9ab74eb54cfd186867f64f240e1a
EMBEDDING_DIMENSIONS=768
# Optional alternative when backend=openai.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Choose groq or openai_compatible; LLM_MODEL overrides the provider default.
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen/qwen3.5-9b
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=2048
# Docker-to-host URL. For native Python, use http://127.0.0.1:1234/v1.
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
# Local DeepEval judge; independent of the application's five-iteration cap.
DEEPEVAL_JUDGE_MODEL=qwen/qwen3.5-9b
DEEPEVAL_JUDGE_BASE_URL=http://127.0.0.1:1234/v1
DEEPEVAL_JUDGE_REASONING_EFFORT=none
DEEPEVAL_JUDGE_MAX_REQUESTS=128
DEEPEVAL_JUDGE_TIMEOUT_SECONDS=1800
DEEPEVAL_JUDGE_REQUEST_TIMEOUT_SECONDS=300
GROQ_REASONING_EFFORT=medium
GROQ_MAX_COMPLETION_TOKENS=2048
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Opt in only when you want bounded redacted prompt/answer payloads in local Langfuse.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_ADMIN_EMAIL=admin@opzen.local
LANGFUSE_ADMIN_PASSWORD=
LANGGRAPH_STRICT_MSGPACK=true
# Hard safety ceiling is 5; lower this to 1-4 for shorter exploration.
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=1800

# Optional host-side Codex gateway (do not copy CLI login credentials into Docker).
# Generate a private key and use the same value for OPENAI_API_KEY and DEEPEVAL_JUDGE_API_KEY.
CODEX_MODEL=gpt-6.1-sol
CODEX_GATEWAY_API_KEY=
CODEX_TIMEOUT_SECONDS=270
CODEX_FORCE_AUTH_JSON=1
# For Codex: LLM_MODEL=gpt-6.1-sol, LLM_REASONING_EFFORT=low,
# OPENAI_BASE_URL=http://host.docker.internal:1235/v1
# DEEPEVAL_JUDGE_MODEL=gpt-6.1-sol, DEEPEVAL_JUDGE_REASONING_EFFORT=low,
# DEEPEVAL_JUDGE_BASE_URL=http://127.0.0.1:1235/v1, DEEPEVAL_JUDGE_PROVIDER_LABEL=Codex CLI

# Above the judge case budget, to avoid leaving an evaluation task running after timeout.
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=2100
